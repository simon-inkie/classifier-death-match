{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["lhr1"],
  "outputDirectory": "public",
  "cleanUrls": false,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "examples/**",
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/logs/:name",
      "destination": "/api/log-file?name=:name"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
